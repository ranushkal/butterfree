<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>File Metadata Extractor</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
            background: white;
            border-radius: 12px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            overflow: hidden;
        }

        .header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 30px;
            text-align: center;
        }

        .header h1 {
            font-size: 2.5em;
            margin-bottom: 10px;
        }

        .header p {
            font-size: 1.1em;
            opacity: 0.9;
        }

        .content {
            padding: 30px;
        }

        .upload-section {
            background: #f8f9fa;
            border: 3px dashed #667eea;
            border-radius: 8px;
            padding: 40px;
            text-align: center;
            margin-bottom: 30px;
            transition: all 0.3s;
        }

        .upload-section:hover {
            border-color: #764ba2;
            background: #f0f1f5;
        }

        .upload-section.dragover {
            background: #e7e9ff;
            border-color: #667eea;
            transform: scale(1.02);
        }

        .file-input-label {
            display: inline-block;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 15px 40px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 1.1em;
            font-weight: 600;
            transition: transform 0.2s;
        }

        .file-input-label:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
        }

        #fileInput {
            display: none;
        }

        .upload-info {
            margin-top: 15px;
            color: #666;
            font-size: 0.95em;
        }

        .controls {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 30px;
        }

        .control-panel {
            background: #f8f9fa;
            padding: 20px;
            border-radius: 8px;
            border: 1px solid #e0e0e0;
        }

        .control-panel h3 {
            color: #667eea;
            margin-bottom: 15px;
            font-size: 1.2em;
        }

        .metadata-options {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 10px;
        }

        .checkbox-label {
            display: flex;
            align-items: center;
            padding: 8px;
            cursor: pointer;
            border-radius: 4px;
            transition: background 0.2s;
        }

        .checkbox-label:hover {
            background: #e7e9ff;
        }

        .checkbox-label input {
            margin-right: 8px;
            cursor: pointer;
        }

        .filter-section {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .filter-row {
            display: grid;
            grid-template-columns: 1fr 1fr auto;
            gap: 10px;
            align-items: center;
        }

        .filter-row select,
        .filter-row input {
            padding: 10px;
            border: 1px solid #ddd;
            border-radius: 4px;
            font-size: 0.95em;
        }

        .btn {
            padding: 10px 20px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-size: 0.95em;
            font-weight: 600;
            transition: all 0.2s;
        }

        .btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
        }

        .btn-secondary {
            background: #6c757d;
            color: white;
        }

        .btn-secondary:hover {
            background: #5a6268;
        }

        .btn-clear {
            background: #dc3545;
            color: white;
        }

        .btn-clear:hover {
            background: #c82333;
        }

        .stats {
            display: flex;
            justify-content: space-around;
            background: #f8f9fa;
            padding: 20px;
            border-radius: 8px;
            margin-bottom: 20px;
        }

        .stat-item {
            text-align: center;
        }

        .stat-value {
            font-size: 2em;
            font-weight: bold;
            color: #667eea;
        }

        .stat-label {
            color: #666;
            font-size: 0.9em;
            margin-top: 5px;
        }

        .table-container {
            overflow-x: auto;
            border-radius: 8px;
            border: 1px solid #e0e0e0;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background: white;
        }

        th {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 15px;
            text-align: left;
            font-weight: 600;
            position: sticky;
            top: 0;
            cursor: pointer;
            user-select: none;
        }

        th:hover {
            background: linear-gradient(135deg, #5568d3 0%, #653a8b 100%);
        }

        th::after {
            content: ' ⇅';
            opacity: 0.5;
        }

        td {
            padding: 12px 15px;
            border-bottom: 1px solid #e0e0e0;
        }

        tr:hover {
            background: #f8f9fa;
        }

        tr.highlight {
            background: #fff3cd !important;
            border-left: 4px solid #ffc107;
        }

        tr.highlight td {
            font-weight: 600;
        }

        .no-data {
            text-align: center;
            padding: 60px 20px;
            color: #999;
        }

        .no-data-icon {
            font-size: 4em;
            margin-bottom: 20px;
        }

        .loading {
            display: none;
            text-align: center;
            padding: 20px;
            color: #667eea;
            font-weight: 600;
        }

        .loading.active {
            display: block;
        }

        .spinner {
            border: 4px solid #f3f3f3;
            border-top: 4px solid #667eea;
            border-radius: 50%;
            width: 40px;
            height: 40px;
            animation: spin 1s linear infinite;
            margin: 0 auto 15px;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .actions {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
        }

        .export-btn {
            background: #28a745;
            color: white;
        }

        .export-btn:hover {
            background: #218838;
        }

        @media (max-width: 768px) {
            .controls {
                grid-template-columns: 1fr;
            }

            .filter-row {
                grid-template-columns: 1fr;
            }

            .stats {
                flex-direction: column;
                gap: 15px;
            }

            .header h1 {
                font-size: 1.8em;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>📄 File Metadata Extractor</h1>
            <p>Upload files to extract and analyze metadata properties</p>
        </div>

        <div class="content">
            <div class="upload-section" id="uploadSection">
                <label for="fileInput" class="file-input-label">
                    📁 Choose Files or Drag & Drop
                </label>
                <input type="file" id="fileInput" multiple accept=".pdf">
                <div class="upload-info">
                    Currently supporting: PDF files (more formats coming soon)
                </div>
            </div>

            <div class="loading" id="loading">
                <div class="spinner"></div>
                Processing files...
            </div>

            <div class="stats">
                <div class="stat-item">
                    <div class="stat-value" id="totalFiles">0</div>
                    <div class="stat-label">Total Files</div>
                </div>
                <div class="stat-item">
                    <div class="stat-value" id="matchingFiles">0</div>
                    <div class="stat-label">Matching Criteria</div>
                </div>
                <div class="stat-item">
                    <div class="stat-value" id="highlightedFiles">0</div>
                    <div class="stat-label">Not Matching</div>
                </div>
            </div>

            <div class="controls">
                <div class="control-panel">
                    <h3>🔧 Metadata Fields</h3>
                    <div class="metadata-options" id="metadataOptions">
                        <label class="checkbox-label">
                            <input type="checkbox" value="fileName" checked>
                            <span>File Name</span>
                        </label>
                        <label class="checkbox-label">
                            <input type="checkbox" value="fileSize" checked>
                            <span>File Size</span>
                        </label>
                        <label class="checkbox-label">
                            <input type="checkbox" value="fileType" checked>
                            <span>File Type</span>
                        </label>
                        <label class="checkbox-label">
                            <input type="checkbox" value="title" checked>
                            <span>Title</span>
                        </label>
                        <label class="checkbox-label">
                            <input type="checkbox" value="author" checked>
                            <span>Author</span>
                        </label>
                        <label class="checkbox-label">
                            <input type="checkbox" value="subject" checked>
                            <span>Subject</span>
                        </label>
                        <label class="checkbox-label">
                            <input type="checkbox" value="creator" checked>
                            <span>Creator</span>
                        </label>
                        <label class="checkbox-label">
                            <input type="checkbox" value="producer" checked>
                            <span>Producer</span>
                        </label>
                        <label class="checkbox-label">
                            <input type="checkbox" value="creationDate" checked>
                            <span>Creation Date</span>
                        </label>
                        <label class="checkbox-label">
                            <input type="checkbox" value="modificationDate" checked>
                            <span>Modification Date</span>
                        </label>
                        <label class="checkbox-label">
                            <input type="checkbox" value="pageCount" checked>
                            <span>Page Count</span>
                        </label>
                        <label class="checkbox-label">
                            <input type="checkbox" value="pdfVersion" checked>
                            <span>PDF Version</span>
                        </label>
                    </div>
                </div>

                <div class="control-panel">
                    <h3>🔍 Search & Filter</h3>
                    <div class="filter-section">
                        <div class="filter-row">
                            <select id="filterField">
                                <option value="">Select Field</option>
                                <option value="fileName">File Name</option>
                                <option value="fileSize">File Size</option>
                                <option value="title">Title</option>
                                <option value="author">Author</option>
                                <option value="subject">Subject</option>
                                <option value="creator">Creator</option>
                                <option value="producer">Producer</option>
                                <option value="pageCount">Page Count</option>
                                <option value="pdfVersion">PDF Version</option>
                            </select>
                            <input type="text" id="filterValue" placeholder="Enter value to match">
                            <button class="btn btn-primary" onclick="applyFilter()">Apply</button>
                        </div>
                        <div style="color: #666; font-size: 0.9em;">
                            Files that don't match the criteria will be highlighted in yellow
                        </div>
                        <button class="btn btn-secondary" onclick="clearFilter()">Clear Filter</button>
                    </div>
                </div>
            </div>

            <div class="actions">
                <button class="btn export-btn" onclick="exportToCSV()">📥 Export to CSV</button>
                <button class="btn export-btn" onclick="exportToJSON()">📥 Export to JSON</button>
                <button class="btn btn-clear" onclick="clearAllFiles()">🗑️ Clear All</button>
            </div>

            <div class="table-container">
                <table id="metadataTable">
                    <thead id="tableHead">
                    </thead>
                    <tbody id="tableBody">
                        <tr>
                            <td colspan="100" class="no-data">
                                <div class="no-data-icon">📂</div>
                                <div>No files uploaded yet. Upload some files to get started!</div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script>
        // Configure PDF.js worker
        pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';

        // Global variables
        let filesData = [];
        let currentFilter = null;
        let sortColumn = null;
        let sortDirection = 'asc';

        // File input handling
        const fileInput = document.getElementById('fileInput');
        const uploadSection = document.getElementById('uploadSection');
        const loading = document.getElementById('loading');

        fileInput.addEventListener('change', handleFiles);

        // Drag and drop
        uploadSection.addEventListener('dragover', (e) => {
            e.preventDefault();
            uploadSection.classList.add('dragover');
        });

        uploadSection.addEventListener('dragleave', () => {
            uploadSection.classList.remove('dragover');
        });

        uploadSection.addEventListener('drop', (e) => {
            e.preventDefault();
            uploadSection.classList.remove('dragover');
            const files = e.dataTransfer.files;
            handleFiles({ target: { files } });
        });

        // Handle file selection
        async function handleFiles(event) {
            const files = Array.from(event.target.files);
            if (files.length === 0) return;

            loading.classList.add('active');

            for (const file of files) {
                try {
                    const metadata = await extractMetadata(file);
                    filesData.push(metadata);
                } catch (error) {
                    console.error(`Error processing ${file.name}:`, error);
                }
            }

            loading.classList.remove('active');
            renderTable();
            updateStats();
            fileInput.value = '';
        }

        // Extract metadata from PDF
        async function extractMetadata(file) {
            const arrayBuffer = await file.arrayBuffer();
            const pdf = await pdfjsLib.getDocument({ data: arrayBuffer }).promise;
            const metadata = await pdf.getMetadata();

            const fileData = {
                fileName: file.name,
                fileSize: formatFileSize(file.size),
                fileSizeBytes: file.size,
                fileType: file.type || 'application/pdf',
                lastModified: new Date(file.lastModified).toLocaleString(),
                title: metadata.info.Title || 'N/A',
                author: metadata.info.Author || 'N/A',
                subject: metadata.info.Subject || 'N/A',
                creator: metadata.info.Creator || 'N/A',
                producer: metadata.info.Producer || 'N/A',
                creationDate: formatPDFDate(metadata.info.CreationDate) || 'N/A',
                modificationDate: formatPDFDate(metadata.info.ModDate) || 'N/A',
                pageCount: pdf.numPages,
                pdfVersion: metadata.info.PDFFormatVersion || 'N/A'
            };

            return fileData;
        }

        // Format file size
        function formatFileSize(bytes) {
            if (bytes === 0) return '0 Bytes';
            const k = 1024;
            const sizes = ['Bytes', 'KB', 'MB', 'GB'];
            const i = Math.floor(Math.log(bytes) / Math.log(k));
            return Math.round((bytes / Math.pow(k, i)) * 100) / 100 + ' ' + sizes[i];
        }

        // Format PDF date
        function formatPDFDate(dateString) {
            if (!dateString) return null;

            // PDF date format: D:YYYYMMDDHHmmSSOHH'mm'
            const match = dateString.match(/D:(\d{4})(\d{2})(\d{2})(\d{2})(\d{2})(\d{2})/);
            if (match) {
                const [, year, month, day, hour, minute, second] = match;
                const date = new Date(year, month - 1, day, hour, minute, second);
                return date.toLocaleString();
            }
            return dateString;
        }

        // Get selected metadata fields
        function getSelectedFields() {
            const checkboxes = document.querySelectorAll('#metadataOptions input[type="checkbox"]:checked');
            return Array.from(checkboxes).map(cb => cb.value);
        }

        // Render table
        function renderTable() {
            const selectedFields = getSelectedFields();
            const tableHead = document.getElementById('tableHead');
            const tableBody = document.getElementById('tableBody');

            if (filesData.length === 0) {
                tableHead.innerHTML = '';
                tableBody.innerHTML = `
                    <tr>
                        <td colspan="100" class="no-data">
                            <div class="no-data-icon">📂</div>
                            <div>No files uploaded yet. Upload some files to get started!</div>
                        </td>
                    </tr>
                `;
                return;
            }

            // Create header
            const headerRow = document.createElement('tr');
            selectedFields.forEach(field => {
                const th = document.createElement('th');
                th.textContent = field.replace(/([A-Z])/g, ' $1').replace(/^./, str => str.toUpperCase());
                th.onclick = () => sortTable(field);
                headerRow.appendChild(th);
            });
            tableHead.innerHTML = '';
            tableHead.appendChild(headerRow);

            // Create body
            tableBody.innerHTML = '';
            filesData.forEach((file, index) => {
                const row = document.createElement('tr');

                // Check if file matches filter criteria
                if (currentFilter && !matchesFilter(file)) {
                    row.classList.add('highlight');
                }

                selectedFields.forEach(field => {
                    const td = document.createElement('td');
                    td.textContent = file[field] || 'N/A';
                    row.appendChild(td);
                });

                tableBody.appendChild(row);
            });
        }

        // Sort table
        function sortTable(column) {
            if (sortColumn === column) {
                sortDirection = sortDirection === 'asc' ? 'desc' : 'asc';
            } else {
                sortColumn = column;
                sortDirection = 'asc';
            }

            filesData.sort((a, b) => {
                let aVal = a[column];
                let bVal = b[column];

                // Handle numeric sorting for file size
                if (column === 'fileSize') {
                    aVal = a.fileSizeBytes;
                    bVal = b.fileSizeBytes;
                }

                // Handle numeric sorting for page count
                if (column === 'pageCount') {
                    aVal = parseInt(aVal) || 0;
                    bVal = parseInt(bVal) || 0;
                }

                if (aVal < bVal) return sortDirection === 'asc' ? -1 : 1;
                if (aVal > bVal) return sortDirection === 'asc' ? 1 : -1;
                return 0;
            });

            renderTable();
        }

        // Apply filter
        function applyFilter() {
            const field = document.getElementById('filterField').value;
            const value = document.getElementById('filterValue').value.trim();

            if (!field || !value) {
                alert('Please select a field and enter a value to filter');
                return;
            }

            currentFilter = { field, value };
            renderTable();
            updateStats();
        }

        // Check if file matches filter
        function matchesFilter(file) {
            if (!currentFilter) return true;

            const fileValue = String(file[currentFilter.field] || '').toLowerCase();
            const filterValue = currentFilter.value.toLowerCase();

            // For numeric fields, try exact match
            if (currentFilter.field === 'pageCount') {
                return parseInt(file[currentFilter.field]) === parseInt(currentFilter.value);
            }

            // For other fields, check if it contains the value
            return fileValue.includes(filterValue);
        }

        // Clear filter
        function clearFilter() {
            currentFilter = null;
            document.getElementById('filterField').value = '';
            document.getElementById('filterValue').value = '';
            renderTable();
            updateStats();
        }

        // Update statistics
        function updateStats() {
            document.getElementById('totalFiles').textContent = filesData.length;

            if (currentFilter) {
                const matching = filesData.filter(file => matchesFilter(file)).length;
                const notMatching = filesData.length - matching;
                document.getElementById('matchingFiles').textContent = matching;
                document.getElementById('highlightedFiles').textContent = notMatching;
            } else {
                document.getElementById('matchingFiles').textContent = filesData.length;
                document.getElementById('highlightedFiles').textContent = 0;
            }
        }

        // Clear all files
        function clearAllFiles() {
            if (filesData.length === 0) return;

            if (confirm('Are you sure you want to clear all files?')) {
                filesData = [];
                currentFilter = null;
                renderTable();
                updateStats();
            }
        }

        // Export to CSV
        function exportToCSV() {
            if (filesData.length === 0) {
                alert('No data to export');
                return;
            }

            const selectedFields = getSelectedFields();
            const headers = selectedFields.map(field =>
                field.replace(/([A-Z])/g, ' $1').replace(/^./, str => str.toUpperCase())
            );

            let csv = headers.join(',') + '\n';

            filesData.forEach(file => {
                const row = selectedFields.map(field => {
                    const value = file[field] || '';
                    return `"${String(value).replace(/"/g, '""')}"`;
                });
                csv += row.join(',') + '\n';
            });

            downloadFile(csv, 'metadata-export.csv', 'text/csv');
        }

        // Export to JSON
        function exportToJSON() {
            if (filesData.length === 0) {
                alert('No data to export');
                return;
            }

            const selectedFields = getSelectedFields();
            const exportData = filesData.map(file => {
                const obj = {};
                selectedFields.forEach(field => {
                    obj[field] = file[field];
                });
                return obj;
            });

            const json = JSON.stringify(exportData, null, 2);
            downloadFile(json, 'metadata-export.json', 'application/json');
        }

        // Download file helper
        function downloadFile(content, filename, contentType) {
            const blob = new Blob([content], { type: contentType });
            const url = URL.createObjectURL(blob);
            const link = document.createElement('a');
            link.href = url;
            link.download = filename;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            URL.revokeObjectURL(url);
        }

        // Update table when metadata options change
        document.getElementById('metadataOptions').addEventListener('change', renderTable);
    </script>
</body>
</html>
