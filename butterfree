<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>File Metadata Extractor</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        // Dark mode configuration
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        primary: {
                            light: '#667eea',
                            DEFAULT: '#667eea',
                            dark: '#764ba2',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        .gradient-bg {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }

        .dark .gradient-bg-dark {
            background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .spinner {
            animation: spin 1s linear infinite;
        }
    </style>
</head>
<body class="min-h-screen gradient-bg dark:gradient-bg-dark transition-colors duration-300">
    <div class="container mx-auto max-w-7xl p-5">
        <!-- Header with Dark Mode Toggle -->
        <div class="gradient-bg rounded-t-xl shadow-2xl text-white p-8 text-center relative">
            <button id="darkModeToggle" class="absolute top-4 right-4 p-2 rounded-lg bg-white/20 hover:bg-white/30 transition-colors duration-200" aria-label="Toggle dark mode">
                <svg id="sunIcon" class="w-6 h-6 text-white hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
                </svg>
                <svg id="moonIcon" class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
                </svg>
            </button>
            <h1 class="text-4xl md:text-5xl font-bold mb-3">📄 File Metadata Extractor</h1>
            <p class="text-lg md:text-xl opacity-90">Upload files to extract and analyze metadata properties</p>
        </div>

        <div class="bg-white dark:bg-gray-800 rounded-b-xl shadow-2xl p-8 transition-colors duration-300">
            <!-- Upload Section -->
            <div id="uploadSection" class="bg-gray-50 dark:bg-gray-700 border-3 border-dashed border-primary rounded-lg p-10 text-center mb-8 transition-all duration-300 hover:border-primary-dark hover:bg-gray-100 dark:hover:bg-gray-600 cursor-pointer">
                <label for="fileInput" class="inline-block gradient-bg text-white px-10 py-4 rounded-lg cursor-pointer text-lg font-semibold transition-all duration-200 hover:-translate-y-1 hover:shadow-lg">
                    📁 Choose Files or Drag & Drop
                </label>
                <input type="file" id="fileInput" multiple accept=".pdf" class="hidden">
                <div class="mt-4 text-gray-600 dark:text-gray-300 text-sm">
                    Currently supporting: PDF files (more formats coming soon)
                </div>
            </div>

            <!-- Loading Indicator -->
            <div id="loading" class="hidden text-center py-5 text-primary font-semibold">
                <div class="spinner border-4 border-gray-200 dark:border-gray-600 border-t-primary rounded-full w-10 h-10 mx-auto mb-4"></div>
                Processing files...
            </div>

            <!-- Statistics -->
            <div class="flex flex-col md:flex-row justify-around bg-gray-50 dark:bg-gray-700 p-5 rounded-lg mb-5 gap-4 transition-colors duration-300">
                <div class="text-center">
                    <div class="text-3xl font-bold text-primary" id="totalFiles">0</div>
                    <div class="text-gray-600 dark:text-gray-300 text-sm mt-1">Total Files</div>
                </div>
                <div class="text-center">
                    <div class="text-3xl font-bold text-primary" id="matchingFiles">0</div>
                    <div class="text-gray-600 dark:text-gray-300 text-sm mt-1">Matching Criteria</div>
                </div>
                <div class="text-center">
                    <div class="text-3xl font-bold text-primary" id="highlightedFiles">0</div>
                    <div class="text-gray-600 dark:text-gray-300 text-sm mt-1">Not Matching</div>
                </div>
            </div>

            <!-- Controls -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-8">
                <!-- Metadata Fields Panel -->
                <div class="bg-gray-50 dark:bg-gray-700 p-5 rounded-lg border border-gray-200 dark:border-gray-600 transition-colors duration-300">
                    <h3 class="text-primary dark:text-primary-light text-xl font-semibold mb-4">🔧 Metadata Fields</h3>
                    <div id="metadataOptions" class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                        <label class="flex items-center p-2 cursor-pointer rounded hover:bg-indigo-50 dark:hover:bg-gray-600 transition-colors duration-200">
                            <input type="checkbox" value="fileName" checked class="mr-2 cursor-pointer w-4 h-4">
                            <span class="text-gray-700 dark:text-gray-200">File Name</span>
                        </label>
                        <label class="flex items-center p-2 cursor-pointer rounded hover:bg-indigo-50 dark:hover:bg-gray-600 transition-colors duration-200">
                            <input type="checkbox" value="fileSize" checked class="mr-2 cursor-pointer w-4 h-4">
                            <span class="text-gray-700 dark:text-gray-200">File Size</span>
                        </label>
                        <label class="flex items-center p-2 cursor-pointer rounded hover:bg-indigo-50 dark:hover:bg-gray-600 transition-colors duration-200">
                            <input type="checkbox" value="fileType" checked class="mr-2 cursor-pointer w-4 h-4">
                            <span class="text-gray-700 dark:text-gray-200">File Type</span>
                        </label>
                        <label class="flex items-center p-2 cursor-pointer rounded hover:bg-indigo-50 dark:hover:bg-gray-600 transition-colors duration-200">
                            <input type="checkbox" value="title" checked class="mr-2 cursor-pointer w-4 h-4">
                            <span class="text-gray-700 dark:text-gray-200">Title</span>
                        </label>
                        <label class="flex items-center p-2 cursor-pointer rounded hover:bg-indigo-50 dark:hover:bg-gray-600 transition-colors duration-200">
                            <input type="checkbox" value="author" checked class="mr-2 cursor-pointer w-4 h-4">
                            <span class="text-gray-700 dark:text-gray-200">Author</span>
                        </label>
                        <label class="flex items-center p-2 cursor-pointer rounded hover:bg-indigo-50 dark:hover:bg-gray-600 transition-colors duration-200">
                            <input type="checkbox" value="subject" checked class="mr-2 cursor-pointer w-4 h-4">
                            <span class="text-gray-700 dark:text-gray-200">Subject</span>
                        </label>
                        <label class="flex items-center p-2 cursor-pointer rounded hover:bg-indigo-50 dark:hover:bg-gray-600 transition-colors duration-200">
                            <input type="checkbox" value="creator" checked class="mr-2 cursor-pointer w-4 h-4">
                            <span class="text-gray-700 dark:text-gray-200">Creator</span>
                        </label>
                        <label class="flex items-center p-2 cursor-pointer rounded hover:bg-indigo-50 dark:hover:bg-gray-600 transition-colors duration-200">
                            <input type="checkbox" value="producer" checked class="mr-2 cursor-pointer w-4 h-4">
                            <span class="text-gray-700 dark:text-gray-200">Producer</span>
                        </label>
                        <label class="flex items-center p-2 cursor-pointer rounded hover:bg-indigo-50 dark:hover:bg-gray-600 transition-colors duration-200">
                            <input type="checkbox" value="creationDate" checked class="mr-2 cursor-pointer w-4 h-4">
                            <span class="text-gray-700 dark:text-gray-200">Creation Date</span>
                        </label>
                        <label class="flex items-center p-2 cursor-pointer rounded hover:bg-indigo-50 dark:hover:bg-gray-600 transition-colors duration-200">
                            <input type="checkbox" value="modificationDate" checked class="mr-2 cursor-pointer w-4 h-4">
                            <span class="text-gray-700 dark:text-gray-200">Modification Date</span>
                        </label>
                        <label class="flex items-center p-2 cursor-pointer rounded hover:bg-indigo-50 dark:hover:bg-gray-600 transition-colors duration-200">
                            <input type="checkbox" value="pageCount" checked class="mr-2 cursor-pointer w-4 h-4">
                            <span class="text-gray-700 dark:text-gray-200">Page Count</span>
                        </label>
                        <label class="flex items-center p-2 cursor-pointer rounded hover:bg-indigo-50 dark:hover:bg-gray-600 transition-colors duration-200">
                            <input type="checkbox" value="pdfVersion" checked class="mr-2 cursor-pointer w-4 h-4">
                            <span class="text-gray-700 dark:text-gray-200">PDF Version</span>
                        </label>
                    </div>
                </div>

                <!-- Filter Panel -->
                <div class="bg-gray-50 dark:bg-gray-700 p-5 rounded-lg border border-gray-200 dark:border-gray-600 transition-colors duration-300">
                    <h3 class="text-primary dark:text-primary-light text-xl font-semibold mb-4">🔍 Search & Filter</h3>
                    <div class="flex flex-col gap-4">
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                            <select id="filterField" class="px-3 py-2 border border-gray-300 dark:border-gray-600 rounded bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-200 focus:ring-2 focus:ring-primary focus:outline-none">
                                <option value="">Select Field</option>
                                <option value="fileName">File Name</option>
                                <option value="fileSize">File Size</option>
                                <option value="title">Title</option>
                                <option value="author">Author</option>
                                <option value="subject">Subject</option>
                                <option value="creator">Creator</option>
                                <option value="producer">Producer</option>
                                <option value="pageCount">Page Count</option>
                                <option value="pdfVersion">PDF Version</option>
                            </select>
                            <input type="text" id="filterValue" placeholder="Enter value to match" class="px-3 py-2 border border-gray-300 dark:border-gray-600 rounded bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-200 focus:ring-2 focus:ring-primary focus:outline-none">
                        </div>
                        <button onclick="applyFilter()" class="gradient-bg text-white px-5 py-2 rounded font-semibold hover:-translate-y-0.5 hover:shadow-lg transition-all duration-200">Apply Filter</button>
                        <div class="text-gray-600 dark:text-gray-300 text-sm">
                            Files that don't match the criteria will be highlighted in yellow
                        </div>
                        <button onclick="clearFilter()" class="bg-gray-600 hover:bg-gray-700 text-white px-5 py-2 rounded font-semibold transition-colors duration-200">Clear Filter</button>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="flex flex-wrap gap-2 mb-5">
                <button onclick="exportToCSV()" class="bg-green-600 hover:bg-green-700 text-white px-5 py-2 rounded font-semibold transition-colors duration-200">📥 Export to CSV</button>
                <button onclick="exportToJSON()" class="bg-green-600 hover:bg-green-700 text-white px-5 py-2 rounded font-semibold transition-colors duration-200">📥 Export to JSON</button>
                <button onclick="clearAllFiles()" class="bg-red-600 hover:bg-red-700 text-white px-5 py-2 rounded font-semibold transition-colors duration-200">🗑️ Clear All</button>
            </div>

            <!-- Table -->
            <div class="overflow-x-auto rounded-lg border border-gray-200 dark:border-gray-600">
                <table id="metadataTable" class="w-full border-collapse bg-white dark:bg-gray-800">
                    <thead id="tableHead">
                    </thead>
                    <tbody id="tableBody">
                        <tr>
                            <td colspan="100" class="text-center py-16 px-5 text-gray-400 dark:text-gray-500">
                                <div class="text-6xl mb-5">📂</div>
                                <div>No files uploaded yet. Upload some files to get started!</div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script>
        // Configure PDF.js worker
        pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';

        // Dark mode functionality
        const darkModeToggle = document.getElementById('darkModeToggle');
        const sunIcon = document.getElementById('sunIcon');
        const moonIcon = document.getElementById('moonIcon');
        const html = document.documentElement;

        // Check for saved theme preference or default to light mode
        const currentTheme = localStorage.getItem('theme') || 'light';
        if (currentTheme === 'dark') {
            html.classList.add('dark');
            sunIcon.classList.remove('hidden');
            moonIcon.classList.add('hidden');
        }

        // Toggle dark mode
        darkModeToggle.addEventListener('click', () => {
            html.classList.toggle('dark');
            const isDark = html.classList.contains('dark');

            // Toggle icons
            sunIcon.classList.toggle('hidden', !isDark);
            moonIcon.classList.toggle('hidden', isDark);

            // Save preference
            localStorage.setItem('theme', isDark ? 'dark' : 'light');
        });

        // Global variables
        let filesData = [];
        let currentFilter = null;
        let sortColumn = null;
        let sortDirection = 'asc';

        // File input handling
        const fileInput = document.getElementById('fileInput');
        const uploadSection = document.getElementById('uploadSection');
        const loading = document.getElementById('loading');

        fileInput.addEventListener('change', handleFiles);

        // Drag and drop
        uploadSection.addEventListener('dragover', (e) => {
            e.preventDefault();
            uploadSection.classList.add('dragover');
        });

        uploadSection.addEventListener('dragleave', () => {
            uploadSection.classList.remove('dragover');
        });

        uploadSection.addEventListener('drop', (e) => {
            e.preventDefault();
            uploadSection.classList.remove('dragover');
            const files = e.dataTransfer.files;
            handleFiles({ target: { files } });
        });

        // Handle file selection
        async function handleFiles(event) {
            const files = Array.from(event.target.files);
            if (files.length === 0) return;

            loading.classList.remove('hidden');

            for (const file of files) {
                try {
                    const metadata = await extractMetadata(file);
                    filesData.push(metadata);
                } catch (error) {
                    console.error(`Error processing ${file.name}:`, error);
                }
            }

            loading.classList.add('hidden');
            renderTable();
            updateStats();
            fileInput.value = '';
        }

        // Extract metadata from PDF
        async function extractMetadata(file) {
            const arrayBuffer = await file.arrayBuffer();
            const pdf = await pdfjsLib.getDocument({ data: arrayBuffer }).promise;
            const metadata = await pdf.getMetadata();

            const fileData = {
                fileName: file.name,
                fileSize: formatFileSize(file.size),
                fileSizeBytes: file.size,
                fileType: file.type || 'application/pdf',
                lastModified: new Date(file.lastModified).toLocaleString(),
                title: metadata.info.Title || 'N/A',
                author: metadata.info.Author || 'N/A',
                subject: metadata.info.Subject || 'N/A',
                creator: metadata.info.Creator || 'N/A',
                producer: metadata.info.Producer || 'N/A',
                creationDate: formatPDFDate(metadata.info.CreationDate) || 'N/A',
                modificationDate: formatPDFDate(metadata.info.ModDate) || 'N/A',
                pageCount: pdf.numPages,
                pdfVersion: metadata.info.PDFFormatVersion || 'N/A'
            };

            return fileData;
        }

        // Format file size
        function formatFileSize(bytes) {
            if (bytes === 0) return '0 Bytes';
            const k = 1024;
            const sizes = ['Bytes', 'KB', 'MB', 'GB'];
            const i = Math.floor(Math.log(bytes) / Math.log(k));
            return Math.round((bytes / Math.pow(k, i)) * 100) / 100 + ' ' + sizes[i];
        }

        // Format PDF date
        function formatPDFDate(dateString) {
            if (!dateString) return null;

            // PDF date format: D:YYYYMMDDHHmmSSOHH'mm'
            const match = dateString.match(/D:(\d{4})(\d{2})(\d{2})(\d{2})(\d{2})(\d{2})/);
            if (match) {
                const [, year, month, day, hour, minute, second] = match;
                const date = new Date(year, month - 1, day, hour, minute, second);
                return date.toLocaleString();
            }
            return dateString;
        }

        // Get selected metadata fields
        function getSelectedFields() {
            const checkboxes = document.querySelectorAll('#metadataOptions input[type="checkbox"]:checked');
            return Array.from(checkboxes).map(cb => cb.value);
        }

        // Render table
        function renderTable() {
            const selectedFields = getSelectedFields();
            const tableHead = document.getElementById('tableHead');
            const tableBody = document.getElementById('tableBody');

            if (filesData.length === 0) {
                tableHead.innerHTML = '';
                tableBody.innerHTML = `
                    <tr>
                        <td colspan="100" class="text-center py-16 px-5 text-gray-400 dark:text-gray-500">
                            <div class="text-6xl mb-5">📂</div>
                            <div>No files uploaded yet. Upload some files to get started!</div>
                        </td>
                    </tr>
                `;
                return;
            }

            // Create header
            const headerRow = document.createElement('tr');
            selectedFields.forEach(field => {
                const th = document.createElement('th');
                th.className = 'gradient-bg text-white px-4 py-4 text-left font-semibold sticky top-0 cursor-pointer select-none hover:opacity-90';
                th.textContent = field.replace(/([A-Z])/g, ' $1').replace(/^./, str => str.toUpperCase()) + ' ⇅';
                th.onclick = () => sortTable(field);
                headerRow.appendChild(th);
            });
            tableHead.innerHTML = '';
            tableHead.appendChild(headerRow);

            // Create body
            tableBody.innerHTML = '';
            filesData.forEach((file, index) => {
                const row = document.createElement('tr');
                row.className = 'hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors duration-150';

                // Check if file matches filter criteria
                if (currentFilter && !matchesFilter(file)) {
                    row.className = 'bg-yellow-100 dark:bg-yellow-900/30 border-l-4 border-yellow-500 hover:bg-yellow-200 dark:hover:bg-yellow-900/50';
                }

                selectedFields.forEach(field => {
                    const td = document.createElement('td');
                    td.className = 'px-4 py-3 border-b border-gray-200 dark:border-gray-700 text-gray-700 dark:text-gray-200';
                    td.textContent = file[field] || 'N/A';
                    row.appendChild(td);
                });

                tableBody.appendChild(row);
            });
        }

        // Sort table
        function sortTable(column) {
            if (sortColumn === column) {
                sortDirection = sortDirection === 'asc' ? 'desc' : 'asc';
            } else {
                sortColumn = column;
                sortDirection = 'asc';
            }

            filesData.sort((a, b) => {
                let aVal = a[column];
                let bVal = b[column];

                // Handle numeric sorting for file size
                if (column === 'fileSize') {
                    aVal = a.fileSizeBytes;
                    bVal = b.fileSizeBytes;
                }

                // Handle numeric sorting for page count
                if (column === 'pageCount') {
                    aVal = parseInt(aVal) || 0;
                    bVal = parseInt(bVal) || 0;
                }

                if (aVal < bVal) return sortDirection === 'asc' ? -1 : 1;
                if (aVal > bVal) return sortDirection === 'asc' ? 1 : -1;
                return 0;
            });

            renderTable();
        }

        // Apply filter
        function applyFilter() {
            const field = document.getElementById('filterField').value;
            const value = document.getElementById('filterValue').value.trim();

            if (!field || !value) {
                alert('Please select a field and enter a value to filter');
                return;
            }

            currentFilter = { field, value };
            renderTable();
            updateStats();
        }

        // Check if file matches filter
        function matchesFilter(file) {
            if (!currentFilter) return true;

            const fileValue = String(file[currentFilter.field] || '').toLowerCase();
            const filterValue = currentFilter.value.toLowerCase();

            // For numeric fields, try exact match
            if (currentFilter.field === 'pageCount') {
                return parseInt(file[currentFilter.field]) === parseInt(currentFilter.value);
            }

            // For other fields, check if it contains the value
            return fileValue.includes(filterValue);
        }

        // Clear filter
        function clearFilter() {
            currentFilter = null;
            document.getElementById('filterField').value = '';
            document.getElementById('filterValue').value = '';
            renderTable();
            updateStats();
        }

        // Update statistics
        function updateStats() {
            document.getElementById('totalFiles').textContent = filesData.length;

            if (currentFilter) {
                const matching = filesData.filter(file => matchesFilter(file)).length;
                const notMatching = filesData.length - matching;
                document.getElementById('matchingFiles').textContent = matching;
                document.getElementById('highlightedFiles').textContent = notMatching;
            } else {
                document.getElementById('matchingFiles').textContent = filesData.length;
                document.getElementById('highlightedFiles').textContent = 0;
            }
        }

        // Clear all files
        function clearAllFiles() {
            if (filesData.length === 0) return;

            if (confirm('Are you sure you want to clear all files?')) {
                filesData = [];
                currentFilter = null;
                renderTable();
                updateStats();
            }
        }

        // Export to CSV
        function exportToCSV() {
            if (filesData.length === 0) {
                alert('No data to export');
                return;
            }

            const selectedFields = getSelectedFields();
            const headers = selectedFields.map(field =>
                field.replace(/([A-Z])/g, ' $1').replace(/^./, str => str.toUpperCase())
            );

            let csv = headers.join(',') + '\n';

            filesData.forEach(file => {
                const row = selectedFields.map(field => {
                    const value = file[field] || '';
                    return `"${String(value).replace(/"/g, '""')}"`;
                });
                csv += row.join(',') + '\n';
            });

            downloadFile(csv, 'metadata-export.csv', 'text/csv');
        }

        // Export to JSON
        function exportToJSON() {
            if (filesData.length === 0) {
                alert('No data to export');
                return;
            }

            const selectedFields = getSelectedFields();
            const exportData = filesData.map(file => {
                const obj = {};
                selectedFields.forEach(field => {
                    obj[field] = file[field];
                });
                return obj;
            });

            const json = JSON.stringify(exportData, null, 2);
            downloadFile(json, 'metadata-export.json', 'application/json');
        }

        // Download file helper
        function downloadFile(content, filename, contentType) {
            const blob = new Blob([content], { type: contentType });
            const url = URL.createObjectURL(blob);
            const link = document.createElement('a');
            link.href = url;
            link.download = filename;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            URL.revokeObjectURL(url);
        }

        // Update table when metadata options change
        document.getElementById('metadataOptions').addEventListener('change', renderTable);
    </script>
</body>
</html>
